generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth models (NextAuth.js v5) ───────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // bcrypt hash for credentials login
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // App data relations
  clubs              Club[]
  sessions           Session[]
  importLogs         ImportLog[]
  bagMappings        BagMapping[]
  wedgeMatrices      WedgeMatrix[]
  deviceConnections  DeviceConnection[]
  tags               Tag[]
}

// ─── App models ─────────────────────────────────────────────────────────────

model Club {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String   // driver, wood, hybrid, iron, wedge, putter
  loft      Float?
  brand     String?
  model     String?
  shaft     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shots     Shot[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  name        String
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  location    String?
  environment String   @default("indoor") // indoor, outdoor
  sessionType String   @default("practice") // practice, gapping, stock_shot, warmup, fitting
  notes       String?
  source      String   @default("manual") // live_bridge, csv_import, json_import, manual
  isLive      Boolean  @default(false)
  isPaused    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shots       Shot[]
  tags        SessionTag[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Shot {
  id               String   @id @default(uuid())
  sessionId        String
  clubId           String?
  shotNumber       Int
  timestamp        DateTime @default(now())

  // Ball data
  ballSpeed        Float?   // mph
  launchAngle      Float?   // degrees vertical
  launchDirection  Float?   // degrees horizontal
  spinRate         Float?   // rpm total
  backSpin         Float?   // rpm
  sideSpin         Float?   // rpm
  spinAxis         Float?   // degrees

  // Distance data
  carryDistance     Float?   // yards
  totalDistance     Float?   // yards
  offlineDistance   Float?   // yards (left negative, right positive)
  apexHeight       Float?   // yards

  // Club data
  clubSpeed        Float?   // mph
  smashFactor      Float?
  angleOfAttack    Float?   // degrees
  clubPath         Float?   // degrees
  faceAngle        Float?   // degrees
  faceToPath       Float?   // degrees
  dynamicLoft      Float?   // degrees

  // Meta
  shotShape        String?  // draw, fade, straight, hook, slice, pull, push
  shotResult       String?  // good, mishit, thin, fat, toe, heel, sky, top, shank
  validity         String   @default("valid") // valid, invalid, warmup, excluded
  source           String   @default("manual") // live_bridge, csv_import, json_import, manual
  rawPayload       String?  // JSON string for debugging

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  club             Club?    @relation(fields: [clubId], references: [id])
  tags             ShotTag[]

  @@index([sessionId])
  @@index([clubId])
  @@index([timestamp])
}

model Tag {
  id          String       @id @default(uuid())
  userId      String
  name        String
  color       String?
  createdAt   DateTime     @default(now())
  sessionTags SessionTag[]
  shotTags    ShotTag[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model SessionTag {
  sessionId String
  tagId     String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sessionId, tagId])
}

model ShotTag {
  shotId String
  tagId  String
  shot   Shot @relation(fields: [shotId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([shotId, tagId])
}

model ImportLog {
  id         String   @id @default(uuid())
  userId     String
  source     String   // csv, json, garmin_api, live_bridge
  filename   String?
  status     String   // pending, processing, completed, failed
  shotCount  Int      @default(0)
  errors     String?  // JSON array of error messages
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BagMapping {
  id          String   @id @default(uuid())
  userId      String
  name        String   @default("My Bag")
  isActive    Boolean  @default(true)
  minShots    Int      @default(5) // minimum shots per club for valid mapping
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clubs       BagMappingClub[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BagMappingClub {
  id            String   @id @default(uuid())
  bagMappingId  String
  clubId        String
  status        String   @default("pending") // pending, in_progress, completed
  avgCarry      Float?
  avgTotal      Float?
  minCarry      Float?   // with outliers removed
  maxCarry      Float?   // with outliers removed
  avgOffline    Float?
  dispersionRadius Float? // yards
  dispersionAngle  Float? // degrees of arc width
  shotCount     Int      @default(0)
  sessionId     String?  // session used for mapping this club
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bagMapping    BagMapping @relation(fields: [bagMappingId], references: [id], onDelete: Cascade)

  @@index([bagMappingId])
  @@index([clubId])
}

model WedgeMatrix {
  id          String   @id @default(uuid())
  userId      String
  name        String   @default("My Wedge Matrix")
  system      String   @default("clock") // clock, percentage, feel
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     WedgeMatrixEntry[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WedgeMatrixEntry {
  id              String   @id @default(uuid())
  wedgeMatrixId   String
  clubId          String
  swingKey        String   // clock: "7", "8", "9", "10"; percentage: "25", "50", "75", "100"; feel: "soft", "medium", "full"
  swingLabel      String   // display name: "7 O'Clock", "50% Swing", etc.
  targetDistance   Float?   // target carry in yards (optional, user-set)
  avgCarry        Float?
  avgTotal        Float?
  avgSpinRate     Float?
  avgLaunchAngle  Float?
  minCarry        Float?
  maxCarry        Float?
  minTotal        Float?
  maxTotal        Float?
  shotCount       Int      @default(0)
  status          String   @default("pending") // pending, in_progress, completed
  notes           String?  // e.g. "Chip length — not a standard partial swing"
  sessionId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  wedgeMatrix     WedgeMatrix @relation(fields: [wedgeMatrixId], references: [id], onDelete: Cascade)

  @@index([wedgeMatrixId])
  @@index([clubId])
}

model DeviceConnection {
  id           String   @id @default(uuid())
  userId       String
  deviceName   String   @default("Garmin Approach R50")
  deviceType   String   @default("r50")
  status       String   @default("disconnected") // connected, disconnected, connecting, error
  lastSeen     DateTime?
  ipAddress    String?
  port         Int?
  protocol     String?  // gspro_open_connect_v1
  metadata     String?  // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
